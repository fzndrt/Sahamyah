{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/scan",
      "schedule": "15 2 * * 1-5"
    }
  ],
  "rewrites": [
    {
      "source": "/api/market/stock/:symbol",
      "destination": "/api/market/stock?symbol=:symbol"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
