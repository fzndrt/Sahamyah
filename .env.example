# APP_URL: URL deployment aplikasi (contoh: https://pilar-idx.vercel.app)
APP_URL=

# CRON_SECRET: Token rahasia untuk melindungi endpoint /api/cron/scan
# Kirim via header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# TELEGRAM_BOT_TOKEN: Opsional, token bot Telegram dari @BotFather untuk alert otomatis
TELEGRAM_BOT_TOKEN=

# TELEGRAM_CHAT_ID: Opsional, ID chat atau channel Telegram tujuan alert
TELEGRAM_CHAT_ID=

# DISCORD_WEBHOOK_URL: Opsional, URL Webhook Discord untuk alert otomatis
DISCORD_WEBHOOK_URL=
